{
  "manufacturer": "SurgeX",
  "productName": "SX-1216-RTi",
  "model": "SX-1216-RTi",
  "series": "Remote Turn-On Series",
  "seriesNote": "국가별 전원·콘센트 규격에 따라 SX-121x-RTi/SX-221x-RT 여러 모델로 나뉜다. 16A/240V·CEE7/7 사양은 SX-1216-RTi 전용.",
  "itemType": "PRODUCT",
