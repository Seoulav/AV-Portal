{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoulav.github.io/AV-Portal/builder/schema/builder-io-request-1.0.schema.json",
  "title": "Builder Portal 반영 요청 1.0",
  "description": "장비 설정 창에서 고친 단자를 Portal 상세 JSON의 io 행 변경으로 묶은 요청(B-20261013-02). node beta/apply-builder-io-request.mjs가 적용한다. 같은 규칙의 코드 검사: builder/engine/io-request.mjs validateIoRequest",
  "type": "object",
  "required": ["schema", "schemaVersion", "productId", "source", "unitId", "library", "changes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "av-portal.builder-io-request" },
    "schemaVersion": { "const": "1.0.0" },
    "productId": { "type": "string", "minLength": 1, "description": "Portal 상세 slug 또는 rtcom-<id>" },
    "source": { "enum": ["portal", "rtcom"], "description": "rtcom이면 적용 스크립트가 거부하고 RTCOM 원본 담당에게 전달하라고 안내한다" },
    "unitId": { "type": "string", "minLength": 1, "description": "라이브러리 배치 단위 ID. 단일 제품이면 productId와 같다. TX/RX·시리즈 단위는 아직 적용하지 않는다" },
    "model": { "type": "string", "description": "사람이 읽는 모델명" },
    "createdAt": { "type": "string", "description": "요청을 만든 시각(ISO 8601)" },
    "library": {
      "type": "object",
      "description": "요청을 만든 라이브러리의 source SHA. 지금과 다르면 적용 스크립트가 경고하고 행마다 before를 확인한다",
      "required": ["catalogSha", "detailSetSha"],
      "additionalProperties": false,
      "properties": {
        "catalogSha": { "type": "string", "minLength": 1 },
        "detailSetSha": { "type": "string", "minLength": 1 },
        "rtcomSha": { "type": "string", "minLength": 1 }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["op", "row", "reason"],
            "additionalProperties": false,
            "properties": {
              "op": { "const": "add" },
              "fromIoIndex": { "$ref": "#/$defs/ioIndex", "description": "고친 행에서 갈라진 새 행이면 원래 행 번호. 적용 스크립트가 그 행의 update를 건너뛰면 이 add도 건너뛴다" },
              "row": { "$ref": "#/$defs/row" },
              "reason": { "$ref": "#/$defs/reason" }
            }
          },
          {
            "type": "object",
            "required": ["op", "ioIndex", "before", "after", "reason"],
            "additionalProperties": false,
            "properties": {
              "op": { "const": "update" },
              "ioIndex": { "$ref": "#/$defs/ioIndex" },
              "before": { "$ref": "#/$defs/row" },
              "after": { "$ref": "#/$defs/row" },
              "reason": { "$ref": "#/$defs/reason" }
            }
          },
          {
            "type": "object",
            "required": ["op", "ioIndex", "before", "reason"],
            "additionalProperties": false,
            "properties": {
              "op": { "const": "remove" },
              "ioIndex": { "$ref": "#/$defs/ioIndex" },
              "before": { "$ref": "#/$defs/row" },
              "reason": { "$ref": "#/$defs/reason" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "ioIndex": { "type": "integer", "minimum": 0, "description": "요청을 만들 때의 상세 io 배열 행 번호" },
    "reason": { "type": "string", "description": "근거(자료명·쪽). 비어 있을 수 있다 — PR 본문에 \"근거 없음\"으로 적는다. 상세 JSON에는 쓰지 않는다" },
    "row": {
      "type": "object",
      "description": "Portal io 행의 원문 다섯 칸. before는 요청을 만들 때의 값(앞뒤 공백 제외)",
      "required": ["group", "connector", "signal", "direction", "quantity"],
      "additionalProperties": false,
      "properties": {
        "group": { "type": "string" },
        "connector": { "type": "string" },
        "signal": { "type": "string" },
        "direction": { "type": "string" },
        "quantity": { "type": "string" }
      }
    }
  }
}
